# TVB Agent Environment Variables Example
# Copy this file to .env and set your secrets locally. DO NOT commit .env to version control.

# Search Provider Configuration
SEARCH_PROVIDER=tavily  # Options: tavily, serpapi, mock
SEARCH_API_KEY=your_search_api_key_here

# Executive Email Verification Provider Configuration
EMAIL_VERIFICATION_PROVIDER=mock  # Options: mock, mx, hunter
EMAIL_VERIFICATION_API_KEY=your_email_verification_api_key_here

# LLM Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime settings
LOG_LEVEL=INFO
TARGET_QUALIFIED_LEADS=15
MAX_CANDIDATE_POOL_SIZE=100
REQUEST_TIMEOUT_SECONDS=10
SQLITE_DB_PATH=tvb_leads.db
